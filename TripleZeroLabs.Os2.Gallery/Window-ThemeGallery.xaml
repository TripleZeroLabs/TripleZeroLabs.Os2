<Window x:Class="TripleZeroLabs.Os2.Gallery.Window_ThemeGallery"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TripleZeroLabs.Os2.Gallery"
        mc:Ignorable="d"
        Title="OS2 Elements Gallery"
        Icon="pack://application:,,,/TripleZeroLabs.Os2.Gallery;component/assets/icon.png"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource OS2.Brush.Background}"
        Width="1040" Height="820"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TripleZeroLabs.Os2;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Local helpers used only by this gallery -->
            <Style x:Key="Gallery.Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource OS2.Brush.Background}" />
                <Setter Property="BorderBrush" Value="{DynamicResource OS2.Brush.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <Style x:Key="Gallery.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource OS2.Text.Heading}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="Gallery.SectionCaption" TargetType="TextBlock" BasedOn="{StaticResource OS2.Text.Caption}">
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <Style x:Key="Gallery.StateLabel" TargetType="TextBlock" BasedOn="{StaticResource OS2.Text.Caption}">
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header banner (dark toolbar chrome) -->
        <Border Grid.Row="0" Background="{DynamicResource OS2.Brush.Toolbar}" Padding="28,20">
            <StackPanel>
                <TextBlock Text="OS2 by Triple Zero Labs"
                           Foreground="{DynamicResource OS2.Brush.ToolbarForeground}"
                           FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Component gallery — buttons, inputs, data grid, tabs, and colors with their hover and active states."
                           Foreground="#C7D0DA" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,24">
            <StackPanel MaxWidth="940" HorizontalAlignment="Left">

                <!-- ============ Typography ============ -->
                <Border Style="{StaticResource Gallery.Card}">
                    <StackPanel>
                        <TextBlock Text="Typography" Style="{StaticResource Gallery.SectionTitle}"/>
                        <TextBlock Text="Heading, body, caption, and label styles." Style="{StaticResource Gallery.SectionCaption}"/>
                        <TextBlock Text="Heading (OS2.Text.Heading)" Style="{StaticResource OS2.Text.Heading}" Margin="0,0,0,8"/>
                        <TextBlock Text="Body text uses the default TextBlock style — 13px Segoe UI in the primary text color, wrapping by default so longer passages flow naturally across the available width."
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Caption text (OS2.Text.Caption) — smaller and subdued for secondary information." Style="{StaticResource OS2.Text.Caption}" Margin="0,0,0,8"/>
                        <Label Content="Label control — form field labels"/>
                    </StackPanel>
                </Border>

                <!-- ============ Buttons ============ -->
                <Border Style="{StaticResource Gallery.Card}">
                    <StackPanel>
                        <TextBlock Text="Buttons" Style="{StaticResource Gallery.SectionTitle}"/>
                        <TextBlock Text="Hover and press each button to see its live states. The right column shows the disabled state."
                                   Style="{StaticResource Gallery.SectionCaption}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- column headers -->
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Enabled" Style="{StaticResource Gallery.StateLabel}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Disabled" Style="{StaticResource Gallery.StateLabel}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Primary (default)" VerticalAlignment="Center"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="Create Parameter" Margin="0,6" MinWidth="150"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="Create Parameter" Margin="16,6,0,6" MinWidth="150" IsEnabled="False"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Secondary (outline)" VerticalAlignment="Center"/>
                            <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource OS2.Button.Secondary}" Content="Download TXT File" Margin="0,6" MinWidth="150"/>
                            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource OS2.Button.Secondary}" Content="Download TXT File" Margin="16,6,0,6" MinWidth="150" IsEnabled="False"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Danger (outline)" VerticalAlignment="Center"/>
                            <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource OS2.Button.Danger}" Content="Delete Collection" Margin="0,6" MinWidth="150"/>
                            <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource OS2.Button.Danger}" Content="Delete Collection" Margin="16,6,0,6" MinWidth="150" IsEnabled="False"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Danger (solid)" VerticalAlignment="Center"/>
                            <Button Grid.Row="4" Grid.Column="1" Style="{StaticResource OS2.Button.DangerSolid}" Content="Delete Permanently" Margin="0,6" MinWidth="150"/>
                            <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource OS2.Button.DangerSolid}" Content="Delete Permanently" Margin="16,6,0,6" MinWidth="150" IsEnabled="False"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Flat (text)" VerticalAlignment="Center"/>
                            <Button Grid.Row="5" Grid.Column="1" Style="{StaticResource OS2.Button.Flat}" Content="Cancel" Margin="0,6" MinWidth="150"/>
                            <Button Grid.Row="5" Grid.Column="2" Style="{StaticResource OS2.Button.Flat}" Content="Cancel" Margin="16,6,0,6" MinWidth="150" IsEnabled="False"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Success (solid)" VerticalAlignment="Center"/>
                            <Button Grid.Row="6" Grid.Column="1" Style="{StaticResource OS2.Button.Success}" Content="Publish Changes" Margin="0,6" MinWidth="150"/>
                            <Button Grid.Row="6" Grid.Column="2" Style="{StaticResource OS2.Button.Success}" Content="Publish Changes" Margin="16,6,0,6" MinWidth="150" IsEnabled="False"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Success (outline)" VerticalAlignment="Center"/>
                            <Button Grid.Row="7" Grid.Column="1" Style="{StaticResource OS2.Button.SuccessSecondary}" Content="Download Report" Margin="0,6" MinWidth="150"/>
                            <Button Grid.Row="7" Grid.Column="2" Style="{StaticResource OS2.Button.SuccessSecondary}" Content="Download Report" Margin="16,6,0,6" MinWidth="150" IsEnabled="False"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ Form controls ============ -->
                <Border Style="{StaticResource Gallery.Card}">
                    <StackPanel>
                        <TextBlock Text="Form Controls" Style="{StaticResource Gallery.SectionTitle}"/>
                        <TextBlock Text="Text fields show a focus ring when focused and a muted fill when disabled." Style="{StaticResource Gallery.SectionCaption}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="TEXTBOX"/>
                                <TextBox Text="john.doe@example.com" Margin="0,0,0,12"/>
                                <Label Content="TEXTBOX (DISABLED)"/>
                                <TextBox Text="Read-only value" IsEnabled="False" Margin="0,0,0,12"/>
                                <Label Content="PASSWORD"/>
                                <PasswordBox Password="secret" Margin="0,0,0,12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="COMBOBOX"/>
                                <ComboBox x:Name="SampleCombo" Margin="0,0,0,12"/>
                                <Label Content="CHECKBOXES"/>
                                <CheckBox Content="Enable notifications" IsChecked="True" Margin="0,4,0,0"/>
                                <CheckBox Content="Remember preferences" IsChecked="True" Margin="0,8,0,0"/>
                                <CheckBox Content="Share anonymous usage data" IsChecked="False" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ Nav + Tabs ============ -->
                <Border Style="{StaticResource Gallery.Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Vertical Nav" Style="{StaticResource Gallery.SectionTitle}"/>
                            <TextBlock Text="OS2.Nav.ListBox — hover and selected states." Style="{StaticResource Gallery.SectionCaption}"/>
                            <Border Background="{DynamicResource OS2.Brush.Surface}" CornerRadius="8" Padding="8">
                                <ListBox Style="{StaticResource OS2.Nav.ListBox}"
                                         ItemContainerStyle="{StaticResource OS2.Nav.ListBoxItem}"
                                         SelectedIndex="1">
                                    <ListBoxItem Content="Dashboard"/>
                                    <ListBoxItem Content="Documents"/>
                                    <ListBoxItem Content="Reports"/>
                                    <ListBoxItem Content="A navigation item with a longer label"/>
                                </ListBox>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tabs" Style="{StaticResource Gallery.SectionTitle}"/>
                            <TextBlock Text="TabControl / TabItem — flat underline tabs." Style="{StaticResource Gallery.SectionCaption}"/>
                            <TabControl Height="180">
                                <TabItem Header="Overview">
                                    <TextBlock Text="Overview tab content." Margin="16"/>
                                </TabItem>
                                <TabItem Header="Details">
                                    <TextBlock Text="Details tab content." Margin="16"/>
                                </TabItem>
                                <TabItem Header="Settings">
                                    <TextBlock Text="Settings tab content." Margin="16"/>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ Data grid ============ -->
                <Border Style="{StaticResource Gallery.Card}">
                    <StackPanel>
                        <TextBlock Text="Data Grid" Style="{StaticResource Gallery.SectionTitle}"/>
                        <TextBlock Text="Sample rows. Hover a row for the hover state; the second row is pre-selected to show the active state." Style="{StaticResource Gallery.SectionCaption}"/>
                        <DataGrid x:Name="SampleGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  Height="240">
                            <DataGrid.RowStyle>
                                <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Active}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource OS2.Brush.RowHighlight}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Name" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource OS2.Brush.TextSecondary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True"
                                                                             Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource OS2.Brush.TextOnPrimarySubtle}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="200"/>
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding Active}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ============ Pickers, progress, toggles ============ -->
                <Border Style="{StaticResource Gallery.Card}">
                    <StackPanel>
                        <TextBlock Text="Pickers, Progress &amp; Toggles" Style="{StaticResource Gallery.SectionTitle}"/>
                        <TextBlock Text="DatePicker, ProgressBar, ToggleButton, Hyperlink, and ToolTip (hover the buttons)." Style="{StaticResource Gallery.SectionCaption}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="DATEPICKER"/>
                                <DatePicker x:Name="SampleDate" Margin="0,0,0,12"/>
                                <Label Content="DATEPICKER (EMPTY / DISABLED)"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <DatePicker Grid.Column="0"/>
                                    <DatePicker x:Name="SampleDateDisabled" Grid.Column="2" IsEnabled="False"/>
                                </Grid>
                                <Label Content="TOGGLEBUTTON (SWITCH)"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                                    <ToggleButton Margin="0,0,12,0"/>
                                    <ToggleButton IsChecked="True" Margin="0,0,12,0"/>
                                    <ToggleButton Content="ON" Tag="OFF" Margin="0,0,12,0"/>
                                    <ToggleButton Content="Visible" Tag="Hidden" IsChecked="True" Margin="0,0,12,0"/>
                                    <ToggleButton Content="ON" Tag="OFF" IsEnabled="False"/>
                                </StackPanel>
                                <Label Content="OS2.TOGGLEBUTTON.SEGMENT"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <ToggleButton Style="{StaticResource OS2.ToggleButton.Segment}" Content="Day" IsChecked="True" Margin="0,0,4,0"/>
                                    <ToggleButton Style="{StaticResource OS2.ToggleButton.Segment}" Content="Week" Margin="0,0,4,0"/>
                                    <ToggleButton Style="{StaticResource OS2.ToggleButton.Segment}" Content="Month"/>
                                </StackPanel>
                                <Label Content="TOOLTIP"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Export" Style="{StaticResource OS2.Button.Secondary}" Margin="0,0,8,0"
                                            ToolTip="Export the current view to PDF"/>
                                    <Button Content="Sync"
                                            ToolTip="Longer tooltip text wraps at the maximum width so that it never runs off the edge of the screen."/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="PROGRESSBAR"/>
                                <ProgressBar Value="65" Margin="0,6,0,14"/>
                                <ProgressBar Value="100" Foreground="{DynamicResource OS2.Brush.Success}" Margin="0,0,0,14"/>
                                <ProgressBar Value="30" Foreground="{DynamicResource OS2.Brush.Danger}" Margin="0,0,0,14"/>
                                <Label Content="PROGRESSBAR (INDETERMINATE)"/>
                                <ProgressBar IsIndeterminate="True" Margin="0,6,0,14"/>
                                <Label Content="HYPERLINK"/>
                                <TextBlock Margin="0,4,0,0">Read the <Hyperlink>release notes</Hyperlink> or the <Hyperlink IsEnabled="False">archived docs</Hyperlink>.</TextBlock>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ Layout: tree, expander, splitter, scroll ============ -->
                <Border Style="{StaticResource Gallery.Card}">
                    <StackPanel>
                        <TextBlock Text="Tree, Expander, Splitter &amp; Scrolling" Style="{StaticResource Gallery.SectionTitle}"/>
                        <TextBlock Text="Drag the splitters (they turn blue on hover). Scrollbars are the slim OS2 style everywhere." Style="{StaticResource Gallery.SectionCaption}"/>
                        <Border BorderBrush="{DynamicResource OS2.Brush.Border}" BorderThickness="1" CornerRadius="6" Height="300">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" MinWidth="140"/>
                                    <ColumnDefinition Width="5"/>
                                    <ColumnDefinition Width="*" MinWidth="200"/>
                                </Grid.ColumnDefinitions>
                                <TreeView Grid.Column="0" BorderThickness="0" Margin="4">
                                    <TreeViewItem Header="Project" IsExpanded="True">
                                        <TreeViewItem Header="Levels" IsExpanded="True">
                                            <TreeViewItem Header="Level 1"/>
                                            <TreeViewItem Header="Level 2" IsSelected="True"/>
                                            <TreeViewItem Header="Roof"/>
                                        </TreeViewItem>
                                        <TreeViewItem Header="Sheets">
                                            <TreeViewItem Header="A101 - Floor Plan"/>
                                            <TreeViewItem Header="A201 - Elevations"/>
                                        </TreeViewItem>
                                        <TreeViewItem Header="Schedules" IsExpanded="True">
                                            <TreeViewItem Header="Door Schedule"/>
                                            <TreeViewItem Header="Window Schedule"/>
                                            <TreeViewItem Header="Room Finish Schedule"/>
                                        </TreeViewItem>
                                    </TreeViewItem>
                                </TreeView>
                                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center"/>
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" MinHeight="80"/>
                                        <RowDefinition Height="5"/>
                                        <RowDefinition Height="*" MinHeight="60"/>
                                    </Grid.RowDefinitions>
                                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="12">
                                        <StackPanel>
                                            <Expander Header="Advanced options" IsExpanded="True" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <CheckBox Content="Include hidden files" IsChecked="True" Padding="0,4"/>
                                                    <CheckBox Content="Overwrite existing parameters" Padding="0,4"/>
                                                </StackPanel>
                                            </Expander>
                                            <Expander Header="Export settings">
                                                <TextBlock Text="Collapsed by default."/>
                                            </Expander>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"/>
                                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="12">
                                        <TextBlock Width="900" Foreground="{DynamicResource OS2.Brush.TextSecondary}"
                                                   Text="Details pane — this text is wider than the pane so both scrollbars appear. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer posuere erat a ante venenatis dapibus posuere velit aliquet. Cras mattis consectetur purus sit amet fermentum. Maecenas faucibus mollis interdum. Donec ullamcorper nulla non metus auctor fringilla. Nullam quis risus eget urna mollis ornare vel eu leo. Vestibulum id ligula porta felis euismod semper."/>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============ Choices, sliders, lists ============ -->
                <Border Style="{StaticResource Gallery.Card}">
                    <StackPanel>
                        <TextBlock Text="Choices, Sliders &amp; Lists" Style="{StaticResource Gallery.SectionTitle}"/>
                        <TextBlock Text="RadioButton, Slider, RepeatButton, GroupBox, ListBox, and ListView with a GridView." Style="{StaticResource Gallery.SectionCaption}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <GroupBox Header="Export range (GroupBox + RadioButton)" Margin="0,0,0,12">
                                    <StackPanel>
                                        <RadioButton Content="Current view" GroupName="GalleryScope" Padding="0,4"/>
                                        <RadioButton Content="Selected views and sheets" GroupName="GalleryScope" IsChecked="True" Padding="0,4"/>
                                        <RadioButton Content="Entire project (disabled)" GroupName="GalleryScope" IsEnabled="False" Padding="0,4"/>
                                    </StackPanel>
                                </GroupBox>
                                <Label Content="REPEATBUTTON STEPPER"/>
                                <StackPanel Orientation="Horizontal">
                                    <RepeatButton Content="&#x2212;" Click="StepDown_Click"/>
                                    <TextBox x:Name="StepValue" Text="12" Width="56" Height="32" Margin="6,0" HorizontalContentAlignment="Center"/>
                                    <RepeatButton Content="+" Click="StepUp_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="SLIDER"/>
                                <Slider Minimum="0" Maximum="100" Value="40" Margin="0,4,0,14"/>
                                <Label Content="SLIDER (TICKS, SNAP TO 10)"/>
                                <Slider Minimum="0" Maximum="100" Value="70" TickFrequency="10" TickPlacement="BottomRight" IsSnapToTickEnabled="True" Margin="0,4,0,14"/>
                                <Label Content="SLIDER (SUCCESS / DISABLED)"/>
                                <Slider Minimum="0" Maximum="100" Value="85" Foreground="{DynamicResource OS2.Brush.Success}" Margin="0,4,0,10"/>
                                <Slider Minimum="0" Maximum="100" Value="55" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="LISTBOX"/>
                                <ListBox Height="180">
                                    <ListBoxItem Content="Architectural"/>
                                    <ListBoxItem Content="Structural" IsSelected="True"/>
                                    <ListBoxItem Content="Mechanical"/>
                                    <ListBoxItem Content="Electrical"/>
                                    <ListBoxItem Content="Plumbing (disabled)" IsEnabled="False"/>
                                    <ListBoxItem Content="Fire protection"/>
                                </ListBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="LISTVIEW + GRIDVIEW (DRAG THE HEADER EDGES TO RESIZE)"/>
                                <ListView Height="180" SelectedIndex="1">
                                    <ListView.Resources>
                                        <XmlDataProvider x:Key="GallerySheets" XPath="/Sheets/Sheet">
                                            <x:XData>
                                                <Sheets xmlns="">
                                                    <Sheet Number="A101" Name="Level 1 Floor Plan" Rev="C"/>
                                                    <Sheet Number="A102" Name="Level 2 Floor Plan" Rev="C"/>
                                                    <Sheet Number="A201" Name="Building Elevations" Rev="B"/>
                                                    <Sheet Number="A301" Name="Wall Sections" Rev="A"/>
                                                    <Sheet Number="A501" Name="Door Schedule" Rev="A"/>
                                                </Sheets>
                                            </x:XData>
                                        </XmlDataProvider>
                                    </ListView.Resources>
                                    <ListView.ItemsSource>
                                        <Binding Source="{StaticResource GallerySheets}"/>
                                    </ListView.ItemsSource>
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Number" Width="90" DisplayMemberBinding="{Binding XPath=@Number}"/>
                                            <GridViewColumn Header="Sheet name" Width="220" DisplayMemberBinding="{Binding XPath=@Name}"/>
                                            <GridViewColumn Header="Rev" Width="60" DisplayMemberBinding="{Binding XPath=@Rev}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ Menus, toolbars, status, rich text ============ -->
                <Border Style="{StaticResource Gallery.Card}">
                    <StackPanel>
                        <TextBlock Text="Menus, Toolbars, Status &amp; Rich Text" Style="{StaticResource Gallery.SectionTitle}"/>
                        <TextBlock Text="A small app frame: Menu bar, ToolBarTray, RichTextBox editor, Separator and StatusBar. Open the menus to see icons, check marks, shortcuts and submenus." Style="{StaticResource Gallery.SectionCaption}"/>
                        <Border BorderBrush="{DynamicResource OS2.Brush.Border}" BorderThickness="1" CornerRadius="6">
                            <DockPanel>
                                <Menu DockPanel.Dock="Top">
                                    <MenuItem Header="_File">
                                        <MenuItem Header="_New project" InputGestureText="Ctrl+N">
                                            <MenuItem.Icon><Path Data="M 0.5 0.5 L 7 0.5 L 10.5 4 L 10.5 13.5 L 0.5 13.5 Z M 7 0.5 L 7 4 L 10.5 4" Style="{StaticResource OS2.Path.Glyph}"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="_Open..." InputGestureText="Ctrl+O">
                                            <MenuItem.Icon><Path Data="M 0.5 2 L 4.5 2 L 6 3.5 L 12.5 3.5 L 12.5 12 L 0.5 12 Z" Style="{StaticResource OS2.Path.Glyph}"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Open _recent">
                                            <MenuItem Header="Tower-A__Central.rvt"/>
                                            <MenuItem Header="Podium__Structure.rvt"/>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="_Auto-save" IsCheckable="True" IsChecked="True"/>
                                        <MenuItem Header="Export to _IFC..." InputGestureText="Ctrl+E" IsEnabled="False"/>
                                        <Separator/>
                                        <MenuItem Header="E_xit" InputGestureText="Alt+F4"/>
                                    </MenuItem>
                                    <MenuItem Header="_Edit">
                                        <MenuItem Header="_Undo" InputGestureText="Ctrl+Z"/>
                                        <MenuItem Header="_Redo" InputGestureText="Ctrl+Y"/>
                                    </MenuItem>
                                    <MenuItem Header="_View">
                                        <MenuItem Header="Thin _lines" IsCheckable="True" IsChecked="True"/>
                                        <MenuItem Header="_Status bar" IsCheckable="True" IsChecked="True"/>
                                    </MenuItem>
                                    <MenuItem Header="_Help"/>
                                </Menu>
                                <ToolBarTray DockPanel.Dock="Top">
                                    <ToolBar>
                                        <Button ToolTip="Save"><Path Data="M 0.5 0.5 L 10 0.5 L 12.5 3 L 12.5 12.5 L 0.5 12.5 Z M 3 0.5 L 3 4 L 9 4 L 9 0.5 M 3 12.5 L 3 8 L 10 8 L 10 12.5" Style="{StaticResource OS2.Path.Glyph}"/></Button>
                                        <Button ToolTip="Undo"><Path Data="M 4 1 L 1 4 L 4 7 M 1 4 L 8.5 4 A 4 4 0 0 1 8.5 12 L 5 12" Style="{StaticResource OS2.Path.Glyph}"/></Button>
                                        <Separator/>
                                        <Button Content="Sync"/>
                                        <Button Content="Publish" IsEnabled="False"/>
                                        <Separator/>
                                        <ToggleButton Content="Snap" IsChecked="True"/>
                                        <ToggleButton Content="Ortho"/>
                                        <Separator/>
                                        <ComboBox Width="120" SelectedIndex="0">
                                            <ComboBoxItem Content="Level 1"/>
                                            <ComboBoxItem Content="Level 2"/>
                                        </ComboBox>
                                        <CheckBox Content="Thin lines" IsChecked="True"/>
                                    </ToolBar>
                                </ToolBarTray>
                                <StatusBar DockPanel.Dock="Bottom">
                                    <StatusBarItem DockPanel.Dock="Right" Content="OS2 gallery"/>
                                    <Separator DockPanel.Dock="Right"/>
                                    <StatusBarItem DockPanel.Dock="Right">
                                        <ProgressBar Value="62" Width="100"/>
                                    </StatusBarItem>
                                    <StatusBarItem Content="Ready"/>
                                    <Separator/>
                                    <StatusBarItem Content="Level 2 - Floor Plan"/>
                                    <StatusBarItem/>
                                </StatusBar>
                                <StackPanel Margin="16">
                                    <Label Content="RICHTEXTBOX"/>
                                    <RichTextBox Height="110">
                                        <FlowDocument>
                                            <Paragraph><Bold>Issue notes</Bold> for Revision C.</Paragraph>
                                            <Paragraph>Updated the <Italic>Level 2</Italic> corridor widths and re-tagged doors D-201 to D-214.</Paragraph>
                                        </FlowDocument>
                                    </RichTextBox>
                                    <Separator/>
                                    <TextBlock Text="A bare Separator draws the hairline above." Style="{StaticResource OS2.Text.Caption}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============ Color palette ============ -->
                <Border Style="{StaticResource Gallery.Card}">
                    <StackPanel>
                        <TextBlock Text="Color Palette" Style="{StaticResource Gallery.SectionTitle}"/>
                        <TextBlock Text="Brand, neutral, and status colors. Left-click or right-click any swatch to copy the hex." Style="{StaticResource Gallery.SectionCaption}"/>
                        <WrapPanel x:Name="SwatchPanel"/>
                    </StackPanel>
                </Border>

                <!-- ============ Messages ============ -->
                <Border Style="{StaticResource Gallery.Card}">
                    <StackPanel>
                        <TextBlock Text="Messages" Style="{StaticResource Gallery.SectionTitle}"/>
                        <TextBlock Text="Banner notifications and modal dialog card." Style="{StaticResource Gallery.SectionCaption}"/>

                        <!-- Banners -->
                        <Border Style="{StaticResource OS2.Banner.Default}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Default" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <TextBlock Text="A neutral status message or informational note with no severity."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource OS2.Banner.Info}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Info" FontWeight="SemiBold"
                                           Foreground="{DynamicResource OS2.Brush.Primary}" Margin="0,0,0,2"/>
                                <TextBlock Text="A helpful tip or a background action has completed successfully."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource OS2.Banner.Warning}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Warning" FontWeight="SemiBold"
                                           Foreground="{DynamicResource OS2.Brush.Warning}" Margin="0,0,0,2"/>
                                <TextBlock Text="Something needs your attention before you continue."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource OS2.Banner.Danger}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Danger" FontWeight="SemiBold"
                                           Foreground="{DynamicResource OS2.Brush.Danger}" Margin="0,0,0,2"/>
                                <TextBlock Text="An error occurred or a destructive action is pending."/>
                            </StackPanel>
                        </Border>

                        <!-- Dialog card preview -->
                        <TextBlock Text="Dialog card" Style="{StaticResource Gallery.SectionTitle}" Margin="0,0,0,12"/>
                        <Border Style="{StaticResource OS2.Dialog}" MaxWidth="420" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="Delete item?" Style="{StaticResource OS2.Text.Heading}" Margin="0,0,0,8"/>
                                <TextBlock Text="This will permanently remove the item and all associated records. This action cannot be undone."
                                           Margin="0,0,0,20"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource OS2.Button.Flat}" Content="Cancel" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource OS2.Button.DangerSolid}" Content="Yes, delete"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Os2MessageBox live demo -->
                        <TextBlock Text="Os2MessageBox" Style="{StaticResource Gallery.SectionTitle}" Margin="0,24,0,4"/>
                        <TextBlock Text="Styled drop-in for MessageBox.Show — same overloads and return types."
                                   Style="{StaticResource Gallery.SectionCaption}" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Information" Click="MsgInfo_Click"    Margin="0,0,8,0" Style="{StaticResource OS2.Button.Secondary}"/>
                            <Button Content="Warning"     Click="MsgWarning_Click" Margin="0,0,8,0" Style="{StaticResource OS2.Button.Secondary}"/>
                            <Button Content="Error"       Click="MsgError_Click"   Margin="0,0,8,0" Style="{StaticResource OS2.Button.Secondary}"/>
                            <Button Content="Question"    Click="MsgQuestion_Click" Margin="0,0,8,0" Style="{StaticResource OS2.Button.Secondary}"/>
                            <Button Content="Plain OK"    Click="MsgPlain_Click"                    Style="{StaticResource OS2.Button.Secondary}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
