<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TripleZeroLabs.Os2 - a dependency-free WPF theme (plain Colors/Controls resource
    dictionaries, no MaterialDesign/MahApps). Multi-targets three runtimes so a
    ProjectReference resolves to the right framework for any host application:
      net48           -> legacy WinForms/WPF hosts and most add-in frameworks
      net8.0-windows  -> .NET 8 LTS apps and modern plugin hosts
      net10.0-windows -> .NET 10 current apps
    Resource-only: the Themes\*.xaml dictionaries compile to BAML in this assembly.
  -->
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows;net10.0-windows</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>TripleZeroLabs.Os2</RootNamespace>
    <AssemblyName>TripleZeroLabs.Os2</AssemblyName>
    <UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Company>Triple Zero Labs, LLC</Company>
    <Product>OS2</Product>
    <Version>0.1.0</Version>
    <Copyright>Copyright © 2026 Triple Zero Labs, LLC</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageDescription>A dependency-free WPF theme (net48/net8/net10) for standalone desktop apps, plugin hosts, and embedded tool windows.</PackageDescription>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>wpf;xaml;dotnet;theme;ui;wpf-theme</PackageTags>
    <RepositoryUrl>https://github.com/TripleZeroLabs/TripleZeroLabs.Os2</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
