<Window x:Class="TripleZeroLabs.Os2.Os2MessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TripleZeroLabs.Os2;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Margin gives the OS2.Dialog DropShadowEffect room to render outside the Border bounds -->
    <Border Style="{StaticResource OS2.Dialog}" Margin="20">
        <StackPanel>

            <!-- Header: circular icon + title (collapsed when both are absent) -->
            <DockPanel x:Name="PART_Header" LastChildFill="True" Margin="0,0,0,12">
                <Border x:Name="PART_IconBorder"
                        DockPanel.Dock="Left"
                        Width="32" Height="32" CornerRadius="16"
                        Margin="0,2,12,0" VerticalAlignment="Top">
                    <TextBlock x:Name="PART_IconText"
                               FontSize="15" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="PART_Title"
                           Style="{StaticResource OS2.Text.Heading}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </DockPanel>

            <!-- Message body -->
            <TextBlock x:Name="PART_Message"
                       Margin="0,0,0,24"
                       TextWrapping="Wrap" />

            <!-- Buttons — populated in code-behind from MessageBoxButton + MessageBoxImage -->
            <StackPanel x:Name="PART_Buttons"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right" />

        </StackPanel>
    </Border>
</Window>
